{
  "schema": "codestra.deployment-contract.v1",
  "repository": "appolon1908/WhatsApp",
  "role": "product-domain-service",
  "standalone_required": true,
  "canonical_integration": {
    "public_edge": "Caddy",
    "api_gateway": "Kong",
    "application_service": "codestra-whatsapp-app",
    "application_submission_route": "/platform/v1/whatsapp/messages",
    "middleware_runtime": "middleware-integration-api:8095",
    "command_api": "/platform/v1/commands",
    "internal_and_metrics_public": false
  },
  "existing_assets": {
    "dockerfile_detected": false,
    "compose_detected": false,
    "kubernetes_or_helm_detected": false,
    "health_or_readiness_signal_detected": true
  },
  "health_readiness": {
    "required": true,
    "status": "implemented-source-only",
    "health_endpoint": "/healthz",
    "readiness_endpoint": "/readyz",
    "certifies_provider_readiness": false
  },
  "secrets": {
    "mode": "references-only",
    "authority": "OpenBao or governed secret files/environment references",
    "committed_secrets_allowed": false
  },
  "production_effects": {
    "default_enabled": false,
    "activation_requires_certification": true
  },
  "promotion": ["development", "testing", "staging", "production"],
  "rollback": {
    "required": true,
    "immutable_sha_or_image_required": true,
    "readback_required": true
  },
  "status": "DESIGN_FOUNDATION"
}
